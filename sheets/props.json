{
 "sheet": "props",
 "about": "Each row is one kind of object HoloCure places on a stage map (trees, pillars, fences, flowers). The importer reads every placement of the row's object from the stage's room in the player's own data.win; the world generator puts a holocraft:<id> block there, drawn as the HoloCure sprite. Generates PropsRow + one block per row.",
 "columns": {
  "id": "string; block id holocraft:prop_<id>",
  "stage": "ref stages.id",
  "object": "holocure object; the room instances to copy",
  "sprite": "holocure sprite",
  "solid": "bool; the 1x1 block at its base collides (trunks, pillars, fences); false = walk-through (flowers, bushes)",
  "shape3d": "cross | slab; Minecraft camera: cross = the sprite pressed into a thick pixel model twice at right angles so round things (trees, bushes, flowers) are solid from every side; slab = one thick pixel model along the prop's facing (fences, walls, signs)",
  "depth_px": "int; thickness of the pixel model in HoloCure pixels"
 },
